# ---- secrets ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AI_PROVIDER=groq            # groq | google | openrouter | openai  (or set AI_BASE_URL for any OpenAI-compatible API)
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile   # google: gemini-2.5-flash | openrouter: meta-llama/llama-3.3-70b-instruct:free (names change, check provider)
# AI_BASE_URL=

# ---- symbols: NAME:SOURCE:ID , comma separated. SOURCE = deriv | yahoo. Blank = agents idle ----
SYMBOLS=R_100:deriv:R_100,EURUSD:yahoo:EURUSD=X,XAUUSD:yahoo:GC=F,ES:yahoo:ES=F

# ---- data / news (blank = skipped) ----
DERIV_WS=wss://api.derivws.com/trading/V1/options/ws/public
NEWS_FEEDS=

# ---- schedule (GMT+6) ----
TZ_OFFSET=6
WINDOW_START=08:00
WINDOW_END=23:00

# ---- guards ----
MIN_CONF=60
MIN_SCORE=60
HIST_CANDLES=1000
LLM_DELAY=2
RUN_ON_START=0
